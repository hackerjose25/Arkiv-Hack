{
  "name": "arkivsight",
  "version": "1.0.0",
  "description": "> Turn Arkiv entities into live, shareable, embeddable dashboards—without writing query or frontend code.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-read.ts",
    "verify:dashboard": "tsx scripts/verify-dashboard.ts",
    "read:dashboard": "tsx examples/independent-reader/read-dashboard.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackerjose25/Arkiv-Hack.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/hackerjose25/Arkiv-Hack/issues"
  },
  "homepage": "https://github.com/hackerjose25/Arkiv-Hack#readme",
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "echarts": "6.1.0",
    "lucide-react": "1.57.0",
    "next": "15.5.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22.13.0"
  }
